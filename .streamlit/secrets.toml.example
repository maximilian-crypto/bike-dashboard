# Vorlage für die Secrets beim Hosting (Streamlit Community Cloud).
#
# LOKAL:  diese Datei zu  .streamlit/secrets.toml  kopieren und ausfüllen
#         (secrets.toml ist in .gitignore und wird NIE committet).
# CLOUD:  denselben Inhalt in Streamlit → App → Settings → Secrets einfügen.
#
# Wichtig: alles FLACHE Schlüssel (keine [Sektionen]). Streamlit stellt sie
# zusätzlich als Umgebungsvariablen bereit, die bikedash.config ausliest.

# --- Datenbank (Neon) -----------------------------------------------------
# Connection-String aus dem Neon-Dashboard (mit ?sslmode=require).
DATABASE_URL = "postgresql://USER:PASSWORT@HOST/DBNAME?sslmode=require"

# --- Zugangsschutz fürs Dashboard ----------------------------------------
# Frei wählbares, langes Passwort. Ohne dieses Secret ist das Dashboard offen!
APP_PASSWORD = "ein-langes-geheimes-passwort"

# --- Strava ---------------------------------------------------------------
STRAVA_CLIENT_ID = "12345"
STRAVA_CLIENT_SECRET = "dein_strava_client_secret"

# --- Whoop ----------------------------------------------------------------
WHOOP_CLIENT_ID = "deine_whoop_client_id"
WHOOP_CLIENT_SECRET = "dein_whoop_client_secret"

# --- Routen (OpenRouteService) + Heimat-Koordinaten -----------------------
ORS_API_KEY = "dein_openrouteservice_key"
ORS_PROFILE = "cycling-regular"
ATHLETE_HOME_LAT = 51.0
ATHLETE_HOME_LON = 7.0
ATHLETE_WEEKLY_HOURS_TARGET = 0

# --- KI-Coach (optional) --------------------------------------------------
ANTHROPIC_API_KEY = "sk-ant-..."
COACH_MODEL = "claude-opus-4-8"

# --- Morgen-Report per ntfy (optional) ------------------------------------
NTFY_TOPIC = "max-bike-7f3a"
